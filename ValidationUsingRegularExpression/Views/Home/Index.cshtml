@model Employee




<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <h2 class="text-center mb-4">Employee Registration Form</h2>
            <div asp-validation-summary="All" class="fw-bold  text-danger "  ></div>
            <form asp-controller="Home" asp-action="Index" method="post">
                <label asp-for="FirstName" class="fw-bold"  >Enter Employee First Name</label>
                <input asp-for="FirstName" class="form-control" placeholder="Enter your first name" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
                <br />
                <label asp-for="LastName" class="fw-bold"  >Enter Employee Last Name</label>
                <input asp-for="LastName" class="form-control" placeholder="Enter your last name" />
                <span asp-validation-for="LastName" class="text-danger"></span>
                <br />
                <label asp-for="Designation" class="fw-bold"  >Enter Employee Designation</label>
                <input asp-for="Designation" class="form-control" placeholder="Enter your designation" />
                <span asp-validation-for="Designation" class="text-danger"></span>
                <br />
                <label asp-for="EmailAddress" class="fw-bold"  >Enter Employee Email Address</label>
                <input asp-for="EmailAddress" class="form-control" placeholder="Enter your email address" />
                <span asp-validation-for="EmailAddress" class="text-danger"></span>
                <br />
                <label asp-for="MobileNumber" class="fw-bold"  >Enter Employee Mobile Number</label>
                <input asp-for="MobileNumber" class="form-control" placeholder="Enter your mobile number" />
                <span asp-validation-for="MobileNumber" class="text-danger"></span>
                <br />
                <label asp-for="DateOfBirth" class="fw-bold">Enter Employee Date of Birth</label>
                <input asp-for="DateOfBirth" class="form-control" placeholder="Enter your date of birth" />
                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                <br />
                <label asp-for="EmployeeAge" class="fw-bold"  >Enter Employee Age</label>
                <input asp-for="EmployeeAge" class="form-control" placeholder="Enter your age" />
                <span asp-validation-for="EmployeeAge" class="text-danger"></span>
                <br />
                <label asp-for="Password" class="fw-bold"  >Enter Employee Password</label>
                <input asp-for="Password" class="form-control" placeholder="Enter your password" />
                <span asp-validation-for="Password" class="text-danger"></span>
                <br />
                <label asp-for="ConfirmPassword" class="fw-bold"  >Confirm Employee Password</label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm your password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                <br />
                <label asp-for="Url" class="fw-bold"  >Enter Employee URL</label>
                <input asp-for="Url" class="form-control" placeholder="Enter your URL" />
                <span asp-validation-for="Url" class="text-danger"></span>
                <br />
                <input type="submit" value="Submit" class="btn btn-primary" />
            </form>
        </div>
    </div>
</div>